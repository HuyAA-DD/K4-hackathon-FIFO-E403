{
  "version": 2,
  "buildCommand": "npm install --prefix CP3-test",
  "builds": [
    {
      "src": "CP3-test/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "CP3-test/public/**",
          "CP3-test/node_modules/pdfjs-dist/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "CP3-test/server.js"
    }
  ]
}
