{
  "version": 2,
  "buildCommand": "npm install --prefix Working-Prototype/v0",
  "builds": [
    {
      "src": "Working-Prototype/v0/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "Working-Prototype/v0/public/**",
          "Working-Prototype/v0/data/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "Working-Prototype/v0/server.js"
    }
  ]
}
